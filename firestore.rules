rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 120)) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSummary(summary) {
      return summary is map &&
        summary.keys().hasAll(['areaSqMeters', 'areaPing', 'edgeCount', 'elementCount']) &&
        summary.keys().hasOnly(['areaSqMeters', 'areaPing', 'edgeCount', 'elementCount']) &&
        summary.areaSqMeters is number && summary.areaSqMeters >= 0 &&
        summary.areaPing is number && summary.areaPing >= 0 &&
        summary.edgeCount is int && summary.edgeCount >= 1 && summary.edgeCount <= 60 &&
        summary.elementCount is int && summary.elementCount >= 0 && summary.elementCount <= 120;
    }

    function isValidFloorplan(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'edges',
          'elements',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'analysisNotes',
          'edges',
          'interiorWalls',
          'elements',
          'sectionLines',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128 &&
        data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 100 &&
        data.ceilingHeightCm is number && data.ceilingHeightCm >= 100 && data.ceilingHeightCm <= 1000 &&
        data.wallThicknessCm is number && data.wallThicknessCm >= 4 && data.wallThicknessCm <= 100 &&
        data.unit is string && data.unit in ['cm', 'm', 'mm'] &&
        data.autoSnapAngles is bool &&
        data.snapToleranceDeg is number && data.snapToleranceDeg >= 0 && data.snapToleranceDeg <= 45 &&
        data.forceClose is bool &&
        (!data.keys().hasAny(['analysisNotes']) || (data.analysisNotes is string && data.analysisNotes.size() <= 1000)) &&
        data.edges is list && data.edges.size() >= 1 && data.edges.size() <= 60 && data.edges[0] is map &&
        (!data.keys().hasAny(['interiorWalls']) || (data.interiorWalls is list && data.interiorWalls.size() <= 40 && (data.interiorWalls.size() == 0 || data.interiorWalls[0] is map))) &&
        data.elements is list && data.elements.size() <= 120 && (data.elements.size() == 0 || data.elements[0] is map) &&
        (!data.keys().hasAny(['sectionLines']) || (data.sectionLines is list && data.sectionLines.size() <= 20 && (data.sectionLines.size() == 0 || data.sectionLines[0] is map))) &&
        isValidSummary(data.summary) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
        incoming().uid == existing().uid;
      allow delete: if false;

      match /floorplans/{planId} {
        allow get: if isValidId(userId) && isValidId(planId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(planId) && isOwner(userId) &&
          isValidFloorplan(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(planId) && isOwner(userId) &&
          isValidFloorplan(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'projectName',
            'ceilingHeightCm',
            'wallThicknessCm',
            'unit',
            'autoSnapAngles',
            'snapToleranceDeg',
            'forceClose',
            'analysisNotes',
            'edges',
            'interiorWalls',
            'elements',
            'sectionLines',
            'summary',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(planId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}

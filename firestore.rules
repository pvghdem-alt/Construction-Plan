rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 120)) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSummary(summary) {
      return summary is map &&
        summary.keys().hasAll(['areaSqMeters', 'areaPing', 'edgeCount', 'elementCount']) &&
        summary.keys().hasOnly(['areaSqMeters', 'areaPing', 'edgeCount', 'elementCount']) &&
        summary.areaSqMeters is number && summary.areaSqMeters >= 0 &&
        summary.areaPing is number && summary.areaPing >= 0 &&
        summary.edgeCount is int && summary.edgeCount >= 1 && summary.edgeCount <= 60 &&
        summary.elementCount is int && summary.elementCount >= 0 && summary.elementCount <= 120;
    }

    function hasValidFloorplanBody(data) {
      return data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 100 &&
        data.ceilingHeightCm is number && data.ceilingHeightCm >= 100 && data.ceilingHeightCm <= 1000 &&
        data.wallThicknessCm is number && data.wallThicknessCm >= 4 && data.wallThicknessCm <= 100 &&
        data.unit is string && data.unit in ['cm', 'm', 'mm'] &&
        data.autoSnapAngles is bool &&
        data.snapToleranceDeg is number && data.snapToleranceDeg >= 0 && data.snapToleranceDeg <= 45 &&
        data.forceClose is bool &&
        (!data.keys().hasAny(['analysisNotes']) || (data.analysisNotes is string && data.analysisNotes.size() <= 1000)) &&
        data.edges is list && data.edges.size() >= 1 && data.edges.size() <= 60 && data.edges[0] is map &&
        (!data.keys().hasAny(['interiorWalls']) || (data.interiorWalls is list && data.interiorWalls.size() <= 40 && (data.interiorWalls.size() == 0 || data.interiorWalls[0] is map))) &&
        data.elements is list && data.elements.size() <= 120 && (data.elements.size() == 0 || data.elements[0] is map) &&
        (!data.keys().hasAny(['sectionLines']) || (data.sectionLines is list && data.sectionLines.size() <= 20 && (data.sectionLines.size() == 0 || data.sectionLines[0] is map))) &&
        (!data.keys().hasAny(['wallColor']) || (data.wallColor is string && data.wallColor.size() == 7 && data.wallColor.matches('^#[0-9a-fA-F]{6}$'))) &&
        (!data.keys().hasAny(['floorColor']) || (data.floorColor is string && data.floorColor.size() == 7 && data.floorColor.matches('^#[0-9a-fA-F]{6}$'))) &&
        (!data.keys().hasAny(['layers']) || (data.layers is list && data.layers.size() <= 30 && (data.layers.size() == 0 || data.layers[0] is map))) &&
        (!data.keys().hasAny(['quoteItems']) || (data.quoteItems is list && data.quoteItems.size() <= 200 && (data.quoteItems.size() == 0 || data.quoteItems[0] is map))) &&
        isValidSummary(data.summary) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidFloorplan(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'edges',
          'elements',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'analysisNotes',
          'edges',
          'interiorWalls',
          'elements',
          'sectionLines',
          'wallColor',
          'floorColor',
          'layers',
          'quoteItems',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128 &&
        hasValidFloorplanBody(data);
    }

    function isValidSharedFloorplan(data) {
      return data.keys().hasAll([
          'ownerId',
          'sourcePlanId',
          'sharedWithEmails',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'edges',
          'elements',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerDisplayName',
          'sourcePlanId',
          'sharedWithEmails',
          'accessLevel',
          'lastEditedByEmail',
          'lastEditedByName',
          'projectName',
          'ceilingHeightCm',
          'wallThicknessCm',
          'unit',
          'autoSnapAngles',
          'snapToleranceDeg',
          'forceClose',
          'analysisNotes',
          'edges',
          'interiorWalls',
          'elements',
          'sectionLines',
          'wallColor',
          'floorColor',
          'layers',
          'quoteItems',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.sourcePlanId) &&
        (!data.keys().hasAny(['ownerDisplayName']) || (data.ownerDisplayName is string && data.ownerDisplayName.size() <= 120)) &&
        data.sharedWithEmails is list &&
        data.sharedWithEmails.size() >= 1 &&
        data.sharedWithEmails.size() <= 20 &&
        data.sharedWithEmails[0] is string &&
        data.sharedWithEmails[0].size() >= 3 &&
        data.sharedWithEmails[0].size() <= 120 &&
        (!data.keys().hasAny(['accessLevel']) || (data.accessLevel is string && data.accessLevel in ['editor', 'viewer'])) &&
        (!data.keys().hasAny(['lastEditedByEmail']) || (data.lastEditedByEmail is string && data.lastEditedByEmail.size() >= 3 && data.lastEditedByEmail.size() <= 120)) &&
        (!data.keys().hasAny(['lastEditedByName']) || (data.lastEditedByName is string && data.lastEditedByName.size() <= 120)) &&
        hasValidFloorplanBody(data);
    }

    function isSharedRecipient(docData) {
      return request.auth.token.email is string &&
        request.auth.token.email.lower() in docData.sharedWithEmails;
    }

    function isSharedEditor(docData) {
      return isSharedRecipient(docData) &&
        (!docData.keys().hasAny(['accessLevel']) || docData.accessLevel == 'editor');
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
        incoming().uid == existing().uid;
      allow delete: if false;

      match /floorplans/{planId} {
        allow get: if isValidId(userId) && isValidId(planId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(planId) && isOwner(userId) &&
          isValidFloorplan(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(planId) && isOwner(userId) &&
          isValidFloorplan(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'projectName',
            'ceilingHeightCm',
            'wallThicknessCm',
            'unit',
            'autoSnapAngles',
            'snapToleranceDeg',
            'forceClose',
            'analysisNotes',
            'edges',
            'interiorWalls',
            'elements',
            'sectionLines',
            'wallColor',
            'floorColor',
            'layers',
            'quoteItems',
            'summary',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(planId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }

    match /shared_floorplans/{shareId} {
      allow get: if isSignedIn() && isValidId(shareId) && (
        (resource == null && shareId.matches('^share_' + request.auth.uid + '_.*$')) ||
        (resource != null && (existing().ownerId == request.auth.uid || isSharedRecipient(existing())))
      );
      allow list: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isSharedRecipient(resource.data));
      allow create: if isSignedIn() && isValidId(shareId) &&
        isValidSharedFloorplan(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/floorplans/$(incoming().sourcePlanId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/floorplans/$(incoming().sourcePlanId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(shareId) &&
        isValidSharedFloorplan(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().sourcePlanId == existing().sourcePlanId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerDisplayName',
              'sharedWithEmails',
              'accessLevel',
              'lastEditedByEmail',
              'lastEditedByName',
              'projectName',
              'ceilingHeightCm',
              'wallThicknessCm',
              'unit',
              'autoSnapAngles',
              'snapToleranceDeg',
              'forceClose',
              'analysisNotes',
              'edges',
              'interiorWalls',
              'elements',
              'sectionLines',
              'wallColor',
              'floorColor',
              'layers',
              'quoteItems',
              'summary',
              'updatedAt'
            ])
          ) ||
          (
            isSharedEditor(existing()) &&
            request.auth.token.email is string &&
            incoming().keys().hasAny(['lastEditedByEmail']) &&
            incoming().lastEditedByEmail == request.auth.token.email.lower() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastEditedByEmail',
              'lastEditedByName',
              'projectName',
              'ceilingHeightCm',
              'wallThicknessCm',
              'unit',
              'autoSnapAngles',
              'snapToleranceDeg',
              'forceClose',
              'analysisNotes',
              'edges',
              'interiorWalls',
              'elements',
              'sectionLines',
              'wallColor',
              'floorColor',
              'layers',
              'quoteItems',
              'summary',
              'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(shareId) && existing().ownerId == request.auth.uid;
    }
  }
}

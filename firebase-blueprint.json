{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sign-in timestamp"
        }
      },
      "required": ["uid", "updatedAt"]
    },
    "FloorplanDocument": {
      "title": "FloorplanDocument",
      "description": "Saved 2D/3D spatial floorplan project owned by a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectName": {
          "type": "string",
          "description": "Floorplan project title",
          "minLength": 1,
          "maxLength": 100
        },
        "ceilingHeightCm": {
          "type": "number",
          "description": "Ceiling height in cm"
        },
        "wallThicknessCm": {
          "type": "number",
          "description": "Wall thickness in cm"
        },
        "unit": {
          "type": "string",
          "enum": ["cm", "m", "mm"],
          "description": "Display unit"
        },
        "autoSnapAngles": {
          "type": "boolean",
          "description": "Auto-snap near orthogonal/diagonal wall angles"
        },
        "snapToleranceDeg": {
          "type": "number",
          "description": "Snap angle tolerance in degrees"
        },
        "forceClose": {
          "type": "boolean",
          "description": "Force close polygon via Bowditch distribution"
        },
        "analysisNotes": {
          "type": "string",
          "description": "Optional recognition or project notes",
          "maxLength": 1000
        },
        "edges": {
          "type": "array",
          "description": "Ordered wall edges (max 60)"
        },
        "interiorWalls": {
          "type": "array",
          "description": "Optional interior partition walls (max 40)"
        },
        "elements": {
          "type": "array",
          "description": "Doors, windows, cabinets, and furniture elements (max 120)"
        },
        "sectionLines": {
          "type": "array",
          "description": "Optional architectural section lines for elevation views (max 20)"
        },
        "wallColor": {
          "type": "string",
          "description": "Optional hex wall surface color",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "floorColor": {
          "type": "string",
          "description": "Optional hex floor surface color",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "layers": {
          "type": "array",
          "description": "Optional element layer definitions for visibility and uniform color (max 30)"
        },
        "quoteItems": {
          "type": "array",
          "description": "Optional construction quotation sheet line items (max 200)"
        },
        "summary": {
          "type": "object",
          "description": "Precomputed display metrics (areaSqMeters, areaPing, edgeCount, elementCount)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "projectName",
        "ceilingHeightCm",
        "wallThicknessCm",
        "unit",
        "autoSnapAngles",
        "snapToleranceDeg",
        "forceClose",
        "edges",
        "elements",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedFloorplanDocument": {
      "title": "SharedFloorplanDocument",
      "description": "Email-shared floorplan document accessible to the owner and listed verified recipient emails with configurable editor or viewer access.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerDisplayName": {
          "type": "string",
          "description": "Optional owner display name",
          "maxLength": 120
        },
        "sourcePlanId": {
          "type": "string",
          "description": "Source floorplan document ID under /users/{ownerId}/floorplans",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sharedWithEmails": {
          "type": "array",
          "description": "Authorized recipient email addresses in lowercase (1 to 20)"
        },
        "accessLevel": {
          "type": "string",
          "enum": ["editor", "viewer"],
          "description": "Recipient permission level (defaults to editor when omitted on legacy shares)"
        },
        "lastEditedByEmail": {
          "type": "string",
          "description": "Email of the last authenticated user who updated the shared floorplan",
          "maxLength": 120
        },
        "lastEditedByName": {
          "type": "string",
          "description": "Display name of the last authenticated user who updated the shared floorplan",
          "maxLength": 120
        },
        "projectName": {
          "type": "string",
          "description": "Floorplan project title",
          "minLength": 1,
          "maxLength": 100
        },
        "ceilingHeightCm": {
          "type": "number",
          "description": "Ceiling height in cm"
        },
        "wallThicknessCm": {
          "type": "number",
          "description": "Wall thickness in cm"
        },
        "unit": {
          "type": "string",
          "enum": ["cm", "m", "mm"],
          "description": "Display unit"
        },
        "autoSnapAngles": {
          "type": "boolean",
          "description": "Auto-snap near orthogonal/diagonal wall angles"
        },
        "snapToleranceDeg": {
          "type": "number",
          "description": "Snap angle tolerance in degrees"
        },
        "forceClose": {
          "type": "boolean",
          "description": "Force close polygon via Bowditch distribution"
        },
        "analysisNotes": {
          "type": "string",
          "description": "Optional recognition or project notes",
          "maxLength": 1000
        },
        "edges": {
          "type": "array",
          "description": "Ordered wall edges (max 60)"
        },
        "interiorWalls": {
          "type": "array",
          "description": "Optional interior partition walls (max 40)"
        },
        "elements": {
          "type": "array",
          "description": "Doors, windows, cabinets, and furniture elements (max 120)"
        },
        "sectionLines": {
          "type": "array",
          "description": "Optional architectural section lines for elevation views (max 20)"
        },
        "wallColor": {
          "type": "string",
          "description": "Optional hex wall surface color",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "floorColor": {
          "type": "string",
          "description": "Optional hex floor surface color",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "layers": {
          "type": "array",
          "description": "Optional element layer definitions for visibility and uniform color (max 30)"
        },
        "quoteItems": {
          "type": "array",
          "description": "Optional construction quotation sheet line items (max 200)"
        },
        "summary": {
          "type": "object",
          "description": "Precomputed display metrics (areaSqMeters, areaPing, edgeCount, elementCount)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Share creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sync server timestamp"
        }
      },
      "required": [
        "ownerId",
        "sourcePlanId",
        "sharedWithEmails",
        "projectName",
        "ceilingHeightCm",
        "wallThicknessCm",
        "unit",
        "autoSnapAngles",
        "snapToleranceDeg",
        "forceClose",
        "edges",
        "elements",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomCabinetDocument": {
      "title": "CustomCabinetDocument",
      "description": "Reusable custom cabinet component template designed by the user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Custom cabinet template ID",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Cabinet template display name",
          "minLength": 1,
          "maxLength": 60
        },
        "baseKind": {
          "type": "string",
          "enum": ["cabinet", "wall_cabinet", "kitchen_counter"],
          "description": "Base element kind"
        },
        "widthCm": {
          "type": "number",
          "description": "Width in cm (20 to 600)"
        },
        "depthCm": {
          "type": "number",
          "description": "Depth in cm (15 to 200)"
        },
        "heightCm": {
          "type": "number",
          "description": "Height in cm (20 to 350)"
        },
        "elevationCm": {
          "type": "number",
          "description": "Bottom elevation off floor in cm (0 to 300)"
        },
        "defaultPlacement": {
          "type": "string",
          "enum": ["wall", "free"],
          "description": "Default placement mode when inserted"
        },
        "color": {
          "type": "string",
          "description": "Optional hex cabinet finish color",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cabinetSpec": {
          "type": "object",
          "description": "Cabinet interior and door/drawer hardware specification (drawerCount 0..6, doorMode, shelfCount 0..8, hasHangingRod, hasSink)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "baseKind",
        "widthCm",
        "depthCm",
        "heightCm",
        "elevationCm",
        "defaultPlacement",
        "cabinetSpec",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile metadata."
    },
    "/users/{userId}/floorplans/{planId}": {
      "schema": {
        "$ref": "#/entities/FloorplanDocument"
      },
      "description": "User-owned cloud-persisted floorplan projects."
    },
    "/users/{userId}/custom_cabinets/{cabinetId}": {
      "schema": {
        "$ref": "#/entities/CustomCabinetDocument"
      },
      "description": "User-owned reusable custom cabinet library templates."
    },
    "/shared_floorplans/{shareId}": {
      "schema": {
        "$ref": "#/entities/SharedFloorplanDocument"
      },
      "description": "Email-shared floorplan documents accessible to the owner and listed verified recipient emails (editor or viewer)."
    }
  }
}
